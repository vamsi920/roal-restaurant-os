rules_version = '2';
// ROAL never lets browsers talk to Firestore. Every read and write goes through the
// Next.js server (route handlers, server actions, /api/agent-tools/*) using the Admin
// SDK, which bypasses these rules. Tenant scoping is enforced in server code
// (lib/auth/context-server.ts). Lock client access down completely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
