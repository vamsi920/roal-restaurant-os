# Copy to `.env` in the project root (see README).
# Next.js loads `.env` automatically. `.env.local` overrides `.env` for duplicate keys.
# If you duplicate a key in `.env.local`, never leave it blank — an empty value overrides a valid `.env` entry.

# --- Demo mode (no keys needed) ---
# With the Firebase block below left blank, `npm run dev` runs in demo mode: one local demo
# owner ("Maria Rossi") is signed in with a click and data lives in an in-memory store,
# persisted to .data/demo-db.json so it survives dev-server restarts.
# Production builds never fall back to demo mode unless you force it:
# ROAL_DEMO_MODE=1
# Demo store file (default .data/demo-db.json); "off" keeps demo data in memory only:
# ROAL_DEMO_DB_FILE=off

# ---- Firebase (client) — leave blank for demo mode ----
# Firebase console → Project settings → Your apps → Web app (see docs/FIREBASE_SETUP.md)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server) — JSON of the service account, single line ----
# Project settings → Service accounts → Generate new private key. Paste the whole JSON on ONE
# line. Server only — never prefix with NEXT_PUBLIC_. Used for Firestore + session cookies.
FIREBASE_SERVICE_ACCOUNT=

# Platform staff — only this email sees Admin / Ops (/dashboard/admin). Optional override.
# PLATFORM_ADMIN_EMAIL=vammu920@gmail.com

# --- Required for menu scanner (POST /api/scanner/extract) ---
OPENAI_API_KEY=your-openai-api-key

# --- Recommended: public site origin (canonicals, OG, billing redirects, Twilio webhook) ---
# Local dev: http://localhost:3000 — Production: https://your-domain.com (no trailing slash)
# On Vercel, VERCEL_URL is used when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: OpenAI model (default gpt-5.4-mini; Chat Completions JSON mode) ---
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING=low

# --- Restaurant name lookup (homepage magic setup) ---
# Google Cloud Places API (New). Required for name+city search.
GOOGLE_PLACES_API_KEY=

# Optional: ElevenLabs phone number id for "Call my phone" during onboarding.
# ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# --- Try-a-call (homepage magic onboarding) ---
# Needs ELEVENLABS_API_KEY (and FIREBASE_SERVICE_ACCOUNT to persist trials outside demo mode). The shared trial agent is created
# automatically (cloned from ELEVENLABS_AGENT_ID with tools stripped, overrides enabled) and
# cached in internal_config. Set this only to pin a specific agent:
# ELEVENLABS_TRIAL_AGENT_ID=
# Spend cap: max demo calls across all visitors per rolling 24h (default 200; calls are capped at 5 min each)
# TRIAL_DAILY_CALL_CAP=200

# --- ElevenLabs Conv AI (server-only; never NEXT_PUBLIC_) ---
# Required for voice agent connect + /api/integrations/elevenlabs/*
ELEVENLABS_API_KEY=
# Default agent when ?agent_id= is omitted
ELEVENLABS_AGENT_ID=
# Agent tools: ElevenLabs calls this app at <base>/api/agent-tools/* (get-menu, sync-draft-order,
# finalize-order, ...). Prefer the signing secret (mints per-restaurant roal1.* tokens on Connect):
AGENT_TOOL_SIGNING_SECRET=
# Legacy global bearer (optional fallback; code uses SIGNING_SECRET first, then this):
# AGENT_TOOL_SECRET=
# Optional: require Authorization: Bearer <token> on POST .../sync-roal-tools
# ELEVENLABS_SYNC_TOKEN=
# Optional: protect GET/POST .../conversation-init (Twilio personalization webhook)
# ELEVENLABS_CONVERSATION_INIT_SECRET=
# ElevenLabs post-call webhook HMAC secret for transcripts/outcomes
# ELEVENLABS_WEBHOOK_SECRET=
# IANA timezone for agent clock context (e.g. America/Chicago)
# RESTAURANT_AGENT_TIMEZONE=
# Set to 0 to skip creating/linking ROAL_order_taker_playbook KB doc
# ROAL_ORDER_KB=
# Public https origin ElevenLabs uses for tool webhooks. Defaults to NEXT_PUBLIC_APP_URL.
# Local dev: ElevenLabs cannot reach localhost — run a tunnel (e.g. `ngrok http 3000` or
# `cloudflared tunnel --url http://localhost:3000`) and put its https URL here, then Connect / Sync.
# ROAL_AGENT_TOOLS_BASE_URL=https://your-tunnel.ngrok-free.app

# --- Playwright E2E smoke (local only; never commit real values) ---
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_RESTAURANT_ID=
# E2E_BASE_URL=http://localhost:3000
# E2E_SKIP_AUTH=1
# E2E_SKIP_SCANNER=1

# --- CLI scripts (optional) ---
# ROAL_SYNC_RESTAURANT_ID=
# ROAL_SYNC_RESTAURANT_NAME=
# SKIP_APP_URL_CHECK=1   # connect-elevenlabs-restaurant.ts only

# --- Planned: billing (Stripe) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Auth domains (Firebase console → Authentication → Settings → Authorized domains) ---
# Add localhost and your production domain. No redirect URLs needed: sign-in happens in the
# browser with the Firebase JS SDK, then POST /api/auth/session exchanges the ID token for an
# httpOnly session cookie.
